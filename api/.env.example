# Copy to api/.env and fill in. Never commit the real .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL; Amazon RDS in production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gts_neuro
# Production only: RDS requires TLS.
# DATABASE_SSLMODE=require

# --- Clerk (https://dashboard.clerk.com -> API keys) ---
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
# Signing secret for the user.* webhook (Clerk dashboard -> Webhooks).
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated origins allowed to mint session tokens (the azp claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Next.js frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Amazon S3 (lesson video, slides, downloads) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
