# Copy to web/.env.local and fill in from the Clerk dashboard.
# Never commit the real .env.local.

# --- Clerk (https://dashboard.clerk.com -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Where Clerk's prebuilt components live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Django API ---
# Server-only: the browser never calls Django directly, so this is not public.
API_BASE_URL=http://127.0.0.1:8000
